{:paths ["src"]
 :deps {org.clojure/core.logic {:mvn/version "1.1.0"}}
 :aliases
 {:storm {;; for disabling the official compiler
          :classpath-overrides {org.clojure/clojure nil}
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                       cider/cider-nrepl {:mvn/version "0.56.0"}
                       refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}
                       com.github.flow-storm/clojure {:mvn/version "1.12.0-10"}
                       com.github.flow-storm/flow-storm-dbg {:mvn/version "4.4.4"}}
          :jvm-opts []
          :main-opts ["-m" "nrepl.cmdline" "--interactive" "--color" "--middleware" "[flow-storm.nrepl.middleware/wrap-flow-storm,cider.nrepl/cider-middleware,refactor-nrepl.middleware/wrap-refactor]"]}}}
